{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  }
}
