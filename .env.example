# Toss Securities Open API (issued in Toss Securities WTS > Settings > Open API; allowed IP registration required)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# Live domestic orders only when 1 (Toss Securities has no paper trading, so real money is spent)
TOSS_LIVE_ORDERS=0

# Hyperliquid agent (API) wallet. Key approved from the main wallet via approveAgent
HL_AGENT_KEY=
HL_ACCOUNT=
# Allow mainnet orders only when 1 (testnet only by default)
HL_ALLOW_MAINNET=0

# Token required for live order API calls (Authorization: Bearer ...)
API_TOKEN=

# GA4 measurement ID (G-XXXXXXX)
VITE_GA_ID=

# Google Apps Script web app (/exec URL) that appends order-launch sign-ups to a Google Sheet. See docs/launch-notify
VITE_NOTIFY_URL=
