# 토스증권 Open API (토스증권 WTS > 설정 > Open API 에서 발급, 허용 IP 등록 필요)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# 1 일 때만 국내 실주문 (토스증권은 모의투자가 없어 실제 돈이 나감)
TOSS_LIVE_ORDERS=0

# 하이퍼리퀴드 에이전트(API) 지갑. 메인 지갑에서 approveAgent 로 승인한 키
HL_AGENT_KEY=
HL_ACCOUNT=
# 1 일 때만 메인넷 주문 허용 (기본 테스트넷만)
HL_ALLOW_MAINNET=0

# 실주문 API 호출에 필요한 토큰 (Authorization: Bearer ...)
API_TOKEN=

# GA4 측정 ID (G-XXXXXXX)
VITE_GA_ID=
