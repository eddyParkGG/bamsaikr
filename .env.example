# 한국투자증권 KIS Developers (https://apiportal.koreainvestment.com)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=12345678-01
# vps=모의투자, prod=실전
KIS_ENV=vps

# 하이퍼리퀴드 에이전트(API) 지갑. 메인 지갑에서 approveAgent 로 승인한 키
HL_AGENT_KEY=
HL_ACCOUNT=
# 1 일 때만 메인넷 주문 허용 (기본 테스트넷만)
HL_ALLOW_MAINNET=0

# 실주문 API 호출에 필요한 토큰 (Authorization: Bearer ...)
API_TOKEN=

# GA4 측정 ID (G-XXXXXXX)
VITE_GA_ID=
